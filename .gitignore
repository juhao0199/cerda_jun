cat >> .gitignore <<'EOF'

# Secrets
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.secret

# Frontend
node_modules/
.next/
out/
coverage/
*.tsbuildinfo

# Backend
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
*.sqlite3

# Database backups
backups/
*.dump
*.sql.gz

# Testing
test-results/
playwright-report/
playwright/.cache/

# System and IDE
.DS_Store
.idea/
.vscode/
*.log

EOF
